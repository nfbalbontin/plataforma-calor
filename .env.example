# Secreto de la tarea diaria de temperatura (cabecera Authorization: Bearer <secreto>).
# En Vercel se llama CRON_SECRET: el cron la envía solo.
TAREA_SECRETO=
# Postgres (por ejemplo Neon). Sin esta variable se usa una base local en .datos/pglite, que no sirve en Vercel.
DATABASE_URL=
# Capa de calor urbano AURA: "1" la activa. No activar en un sitio público sin autorización escrita de AURA.
MODULO_AURA=0
