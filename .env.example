# Clave única de administrador para la sección de carga (S11). Obligatoria.
ADMIN_CLAVE=
# Secreto de la tarea diaria (cabecera Authorization: Bearer <secreto>). Obligatorio.
TAREA_SECRETO=
# Postgres (Neon). Sin esta variable se usa una base local en .datos/pglite.
DATABASE_URL=
# Módulos de terceros que se pueden retirar (RNF-13): "1" activa.
MODULO_AURA=0
MODULO_IMPACTLAB=1
